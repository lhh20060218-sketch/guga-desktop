# ================= 咕嘎管家体验版 · 服务器配置 =================
# 复制为 .env 后填写（或直接写入 systemd 环境变量）

# 监听端口（默认 3000）
PORT=3000

# 大模型（OpenAI 兼容格式，三行都必填）
# 智谱:   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-flash
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com              LLM_MODEL=deepseek-chat
# 通义:   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 评委测试账号（务必改成自己的）
JUDGE_USER=judge
JUDGE_PASS=Guga@2026
